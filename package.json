{
	"name": "seatwise",
	"description": "Система оптимізації розсадки учасників нетворкінгу",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"compile:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "svelte-kit sync && npm run compile:paraglide && (husky || echo '')",
		"bump": "node scripts/bump-version.mjs",
		"version:patch": "npm version patch --no-git-tag-version",
		"check": "npm run compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:build": "node scripts/check-build.mjs",
		"lint": "npm run lint:format && npm run lint:code",
		"lint:format": "prettier --check .",
		"lint:code": "eslint .",
		"format": "prettier --write .",
		"audit:ci": "node scripts/check-audit.mjs",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.15.2",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^8.54.0",
		"@typescript-eslint/parser": "^8.54.0",
		"@vitest/browser-playwright": "^4.1.3",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"husky": "^9.1.7",
		"phosphor-svelte": "^3.1.1",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.4.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	}
}
